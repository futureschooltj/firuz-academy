rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasMe() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return hasMe() && me().role == 'admin' && me().active == true; }
    function isActive() { return hasMe() && me().active == true; }
    function mySid() { return me().sid; }
    function notInitialized() { return !exists(/databases/$(database)/documents/config/init); }

    // Тугмаи якуми танзим: танҳо як маротиба, то замоне ки config/init нест
    match /config/{d} {
      allow read: if true;
      allow create: if signedIn() && notInitialized() && d == 'init';
      allow update, delete: if false;
    }

    // Профили корбар
    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      // Сабти ном: хонанда барои худ; маъмури аввал танҳо ҳангоми танзими якум
      allow create: if signedIn() && request.auth.uid == uid &&
        ((request.resource.data.role == 'student' && request.resource.data.active == true) ||
         (request.resource.data.role == 'admin' && notInitialized()));
      // Корбар танҳо mustChange-ро иваз мекунад; маъмур ҳама чизро
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange']));
      allow delete: if isAdmin();
    }

    // Харитаи ID -> почтаи вуруд (барои вуруд бе ворид шудан хондан лозим)
    match /logins/{k} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if signedIn() && (isAdmin() ||
        (request.resource.data.uid == request.auth.uid && !exists(/databases/$(database)/documents/logins/$(k))));
      allow update, delete: if isAdmin();
    }

    // Дархости барқарорсозии парол — ҳамаро мешавад фиристод, танҳо маъмур мехонад
    match /resets/{r} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Мундариҷаи умумӣ
    match /settings/{d}      { allow read: if true; allow write: if isAdmin(); }
    match /bundles/{d}       { allow read: if true; allow write: if isAdmin(); }
    match /announcements/{d} { allow read: if isActive(); allow write: if isAdmin(); }
    match /audit/{d}         { allow read: if isAdmin(); allow create: if isActive(); allow update, delete: if false; }

    // Курсҳо ва қисматҳои онҳо
    match /courses/{cid} {
      allow read: if true;
      allow write: if isAdmin();

      match /items/{iid} {
        // Дастрасӣ: маъмур; ё курс ройгон; ё хонанда доштани дастрасии фаъол
        allow read: if isAdmin() || (isActive() && (
            get(/databases/$(database)/documents/courses/$(cid)).data.free == true ||
            resource.data.free == true ||
            (exists(/databases/$(database)/documents/students/$(mySid())/access/$(cid)) &&
             get(/databases/$(database)/documents/students/$(mySid())/access/$(cid)).data.active == true)));
        allow write: if isAdmin();
      }
    }

    // Маълумоти хонанда
    match /students/{sid} {
      match /access/{cid} {
        allow read: if isAdmin() || (isActive() && mySid() == sid);
        allow write: if isAdmin();
      }
      match /orders/{oid} {
        allow read: if isAdmin() || (isActive() && mySid() == sid);
        // Хонанда фармоиши худро танҳо бо ҳолати 'contact' месозад
        allow create: if isAdmin() || (isActive() && mySid() == sid &&
          request.resource.data.sid == sid && request.resource.data.status == 'contact');
        allow update, delete: if isAdmin();
      }
      match /progress/{cid} {
        allow read, write: if isAdmin() || (isActive() && mySid() == sid);
      }
      match /results/{rid} {
        allow read: if isAdmin() || (isActive() && mySid() == sid);
        allow create: if isActive() && mySid() == sid;
        allow update, delete: if isAdmin();
      }
    }

    // Гурӯҳҳои коллексия (барои панели маъмур)
    match /{path=**}/orders/{oid}  { allow read: if isAdmin(); }
    match /{path=**}/access/{cid}  { allow read: if isAdmin(); }
  }
}
